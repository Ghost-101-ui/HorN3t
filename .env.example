# HorNet — sample .env file
# Copy to project root or set these in your shell.
# CLI flags take precedence over these env vars.

# ── Backend mode ─────────────────────────────────────────────────────────────
# "local"  → Ollama (default)
# "online" → OpenRouter (or custom)
HNET_MODE=local

# ── Local Ollama ──────────────────────────────────────────────────────────────
HNET_BASE_URL=http://localhost:11434/v1
HNET_MODEL=llama3
HNET_API_KEY=ollama

# ── OpenRouter (uncomment to use) ─────────────────────────────────────────────
# HNET_MODE=online
# HNET_BASE_URL=https://openrouter.ai/api/v1
# HNET_MODEL=anthropic/claude-3-haiku
# HNET_API_KEY=sk-or-...

# ── Session & log paths ───────────────────────────────────────────────────────
# HNET_SESSION_DIR=~/.hornet/sessions
# HNET_LOG_DIR=~/.hornet/logs

# ── Debug ─────────────────────────────────────────────────────────────────────
# HNET_DEBUG=1
