{
  "_comment": "HorNet configuration — copy this to ~/.hornet/hnet.config.json or your project root",

  "mode": "local",

  "local": {
    "base_url": "http://localhost:11434/v1",
    "model": "llama3",
    "api_key": "ollama",
    "timeout": 120,
    "max_tokens": 2048,
    "temperature": 0.2
  },

  "online": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "anthropic/claude-3-haiku",
    "api_key": "YOUR_OPENROUTER_KEY_HERE",
    "timeout": 60,
    "max_tokens": 2048,
    "temperature": 0.2
  },

  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "anthropic/claude-3-haiku",
    "api_key": "YOUR_OPENROUTER_KEY_HERE",
    "timeout": 60,
    "max_tokens": 2048,
    "temperature": 0.2
  },

  "session_dir": "~/.hornet/sessions",
  "log_dir":     "~/.hornet/logs",
  "max_loop_steps": 20,
  "debug": false
}
